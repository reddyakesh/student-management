services: 
  web:
    image: wordpress:latest
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_USER: user
      WORDPRESS_DB_PASSWORD: admin
      WORDPRESS_DB_NAME: demo_db
    ports:
      - "8081:80"
    networks:
      - app-net
    depends_on:
      - db

  db:
    image: mysql:8.0    
    environment:
      MYSQL_USER: user
      MYSQL_PASSWORD: admin
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: demo_db
    volumes:
      - db-data:/var/lib/mysql
      

    networks:
      - app-net


networks:
    app-net:

volumes:
    db-data:            




services:
  web:
    image: nginx:latest
    ports:
      - "8081:80" 
    networks: 
      - app-net   
    depends_on:
      - db
       



  db:
    image: postgres:15
    environment:
      POSTGRES_USER: demo
      POSTGRES_PASSWORD: demo
      POSTGRES_DB: demo_db    
    volumes:
     - db-data:/var/lib/postgresql/data
    networks: 
     - app-net   

  
networks:
  app-net:

volumes: 
  db-data:



